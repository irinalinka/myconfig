general {
    output_format = "i3bar"
    colors = true
    interval = 3
    separator = "  "
    color_good = "#00ff00"
    color_degraded = "#f9e2af"
    color_bad = "#ff0000"
}

order += "battery all"
order += "cpu_usage"
order += "cpu_temperature 0"
order += "memory"
order += "wireless _first_"
order += "ethernet _first_"
order += "disk /"
order += "tztime local"

cpu_usage {
    format = " CPU %usage "
    max_threshold = 90
    degraded_threshold = 70

    format_above_degraded_threshold = " CPU HIGH %usage "
    format_above_threshold = " CPU CRITICAL %usage "
}

cpu_temperature 0 {
    format = " TEMP %degrees°C "
    path = "/sys/class/thermal/thermal_zone5/temp"

    max_threshold = 80
    format_above_threshold = " ON FIRE %degrees°C "
}

memory {
    format = " RAM %used in use "
    memory_used_method = "memavailable"
    unit = "auto"
    decimals = 1
    threshold_degraded = "15%"
    threshold_critical = "7%"

    format_degraded = " RAM LOW %available free "
}

disk "/" {
    format = " HDD %percentage_used used "

    low_threshold = 10
    threshold_type = "percentage_avail"
}

wireless _first_ {
    format_up = " WIFI%quality "
    format_down = " WIFI DOWN "
}

ethernet _first_ {
    format_up = " ETH%ip "
    format_down = " ETH DOWN "
}

battery all {
    format = " %status %percentage "
    format_down = " BAT N/A "

    status_chr = "CHR"
    status_bat = "DCHR"
    status_unk = "BAT?"
    status_full = "FULL"

    low_threshold = 15
    last_full_capacity = true
}

tztime local {
    format = " %a %d %b %H:%M "
    timezone = "Asia/Calcutta"
}
